# Python bytecode — regenerated on every run, never source.
__pycache__/
*.py[cod]

# Editor-local preferences. Personal to the machine, not to the project.
.vscode/

# Personal vault files. Never commit these: they are your encrypted data,
# the salt needed to open it, and your settings.
Bunker.mmf
bunker.cfg
bunker.salt
# Settings and integrity record BUNKER writes next to the vault. A copy committed
# from a previous run stops a new install from starting (settings are tied to
# the salt), so they must never be tracked.
config.cfg
bunker.chk
*.prev
*.bak.*
# Exports and saved network reports written by the app.
network_info_*.txt
